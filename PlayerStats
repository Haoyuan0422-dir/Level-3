using UnityEngine;
using TMPro; 

public class PlayerStats : MonoBehaviour
{
    [Header("Player Stats")]
    public string playerName = "HERO";
    public int level = 1;
    public int hp = 10;
    public int damage = 2;
    public int exp = 0;
    public int coins = 0;

    [Header("UI References")]
    public TMP_Text nameText; // Drag your Tab Menu Text here
    public TMP_Text hpText;
    public TMP_Text damageText;
    public TMP_Text expText;

    private void Start()
    {
        UpdateUI();
    }

    public void AddExp(int amount)
    {
        exp += amount;
        if (exp >= 100) // Simple level up logic
        {
            LevelUp();
        }
        UpdateUI();
    }

    private void LevelUp()
    {
        level++;
        hp += 5;
        damage += 1;
        exp = 0; // Reset EXP after level up
    }

    // Refreshes the Tab Menu text
    public void UpdateUI()
    {
        if (nameText != null) nameText.text = "NAME: " + playerName + " (Lv." + level + ")";
        if (hpText != null) hpText.text = "HP: " + hp;
        if (damageText != null) damageText.text = "DAMAGE: " + damage;
        if (expText != null) expText.text = "EXP: " + exp + "/100";
    }
}
